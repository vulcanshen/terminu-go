<!--
  hosts (/etc/hosts), which chroma has no lexer for (tdp file-picker.3,
  "Where chroma leaves a gap"): an address, 127.0.0.1 or ::1, is
  LiteralNumber; a comment is Comment.
-->
<lexer>
  <config>
    <name>hosts</name>
    <alias>hosts</alias>
    <filename>hosts</filename>
  </config>
  <rules>
    <state name="root">
      <rule pattern="#.*">
        <token type="Comment"/>
      </rule>
      <rule pattern="\s+">
        <token type="Text"/>
      </rule>
      <rule pattern="(?:\d{1,3}\.){3}\d{1,3}(?![\w.-])">
        <token type="LiteralNumber"/>
      </rule>
      <rule pattern="[0-9A-Fa-f]*:[0-9A-Fa-f:.]*(?:%[\w.]+)?">
        <token type="LiteralNumber"/>
      </rule>
      <rule pattern="[^\s#]+">
        <token type="Text"/>
      </rule>
    </state>
  </rules>
</lexer>
